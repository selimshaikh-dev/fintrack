@model FinTrack.Application.Common.Models.EmailBodyVM
<tr>
    <td align="center">
        <span style="color:#48545d;font-size:14px;line-height:24px">
            Your email was used to create a new account in www.FinTrack.com. To complete the registration process please click the Confirm Account button below to active your account and your 
            default password is <strong>@Model.OldPassword</strong>  to log in your account.
        </span>
    </td>
</tr>
<tr>
    <td></td>
</tr>
<tr>
    <td width="48%" valign= "top" align="center">
        <span>
             <a href="@Model.CallBackUrl" style="display:block;padding:15px 25px;background-color:#47bb70;color:#ffffff;border-radius:3px;text-decoration:none" target="_blank"> Confirm Account</a>
        </span>
    </td>
</tr>
<tr>
    <td></td>
</tr>
<tr>
    <td>
        To reset your password, click on the button below:
    </td>
</tr>
<tr>
    <td></td>
</tr>
<tr>
    <td width="48%" valign= "top" align="center">
        <span>
            <a href="@Model.CallBackUrlForChangedPassword" style="display:block;padding:15px 25px;background-color:#47bb70;color:#ffffff;border-radius:3px;text-decoration:none" target="_blank"> Set Password</a>
        </span>
    </td>
</tr>

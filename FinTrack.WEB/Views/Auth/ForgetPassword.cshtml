@model FinTrack.Application.Common.Models.EmailBodyVM
<tr>
    <td align="center">
        <span style="color:#48545d;font-size:14px;line-height:24px">
                You have recently requested to reset password for your online account at Globe Securities Ltd. Click the button below to reset it.
        </span>
    </td>
</tr>
<tr><td height="20"></td></tr>
<tr>
    <td width="48%" valign= "top" align="center">
        <span>
            <a href="@Model.CallBackUrl" style="display:block;padding:15px 25px;background-color:#47bb70;color:#ffffff;border-radius:3px;text-decoration:none" target="_blank"> Reset Password</a>
        </span>
        <br /><br />
        <span>
            If you are having trouble clicking the reset password button, copy and paste the URL below into your web browser
            @Model.CallBackUrl
        </span>
    </td>
</tr>
<tr><td height="20"></td></tr>
<tr>
    <td align="center">
        <p style="color:#a2a2a2;font-size:12px;line-height:17px;font-style:italic">
            If you did not request a password reset, please ignore this Email or reply to let us know. This password reset link is only valid for next 7 days.
        </p>
    </td>
</tr>
